// Prisma Schema — Klas Berdaya
// Database: MySQL
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  VALIDATOR
  USER
}

model User {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  passwordHash  String    @db.VarChar(255)
  role          UserRole  @default(USER)
  // Keep existing string columns for migration
  kabupatenName String?   @db.VarChar(100) @map("kabupaten")
  kecamatanName String?   @db.VarChar(100) @map("kecamatan")
  // New fields for relational data
  kabupatenId   Int?      @db.Int
  kecamatanId   Int?      @db.Int
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  selfAssessments SelfAssessment[]
  validations     AssessmentValidation[]
  assessmentVersionsCreated AssessmentVersion[] @relation("AssessmentVersionCreator")
  assessmentStatuses UserAssessmentStatus[] @relation("UserAssessmentStatuses")
  draftBackups    AssessmentDraftBackup[]

  // Relations
  kabupaten     Wilayah?  @relation("UserKabupaten", fields: [kabupatenId], references: [id])
  kecamatan     Wilayah?  @relation("UserKecamatan", fields: [kecamatanId], references: [id])

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// WILAYAH (provinsi, kabupaten/kota, kecamatan, dsb.)
// ─────────────────────────────────────────────────────────────

model Wilayah {
  id          Int      @id @default(autoincrement())
  kode        String   @unique @db.VarChar(13)   // Kode Wilayah (misal: 33, 33.01, 33.01.01)
  nama        String   @db.VarChar(100)          // Nama Wilayah
  level       Int      @db.Int                   // 1: Provinsi, 2: Kabupaten/Kota, 3: Kecamatan, 4: Desa, dsb.
  parentId    Int?     @db.Int                   // Referensi ke Wilayah induk (null untuk provinsi)
  lat         Float?   @db.Double                // Latitude in degrees
  lng         Float?   @db.Double                // Longitude in degrees
  luas        Float?   @db.Double                // Area in km2
  penduduk    Float?   @db.Double                // Population
  path        String?  @db.LongText              // Boundaries/polygon area (GeoJSON or WKT)
  status      Int?     @db.Int                   // Status kode wilayah

  // Relations
  parent      Wilayah? @relation("WilayahParent", fields: [parentId], references: [id])
  children    Wilayah[] @relation("WilayahParent")
  // Reverse relations for User
  usersAsKabupaten User[] @relation("UserKabupaten")
  usersAsKecamatan User[] @relation("UserKecamatan")

  @@map("wilayah")
}

// ─────────────────────────────────────────────────────────────
// ASSESSMENT (template yang dibuat admin)
// ─────────────────────────────────────────────────────────────

enum AssessmentTemplateStatus {
  DRAFT
  PUBLISHED
  REVISION    // Admin sedang update, kecamatan tidak bisa mengisi
  ARCHIVED
}

model Assessment {
  id          Int                      @id @default(autoincrement())
  title       String                   @db.VarChar(255)
  description String?                  @db.Text
  periode     String                   @db.VarChar(20)
  status      AssessmentTemplateStatus @default(DRAFT)
  currentVersion Int                   @default(1) @map("current_version")
  lastMajorUpdateAt DateTime?          @map("last_major_update_at")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  categories  AssessmentCategory[]
  rubrics     AssessmentRubric[]
  versions    AssessmentVersion[]
  userStatuses UserAssessmentStatus[]
  draftBackups AssessmentDraftBackup[]

  @@map("assessments")
}

// ─────────────────────────────────────────────────────────────
// ASSESSMENT CATEGORY
// ─────────────────────────────────────────────────────────────

model AssessmentCategory {
  id           Int        @id @default(autoincrement())
  assessmentId Int
  code         String     @db.VarChar(10)    // contoh: "A", "B"
  name         String     @db.VarChar(255)
  description  String?    @db.Text
  order        Int        @default(0)
  scoringRule  Json?      @map("scoring_rule") // custom threshold: [{ max: 5, label: "Belum Berdaya" }, ...]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  indicators AssessmentIndicator[]

  @@unique([assessmentId, code])
  @@map("assessment_categories")
}

// ─────────────────────────────────────────────────────────────
// ASSESSMENT INDICATOR
// ─────────────────────────────────────────────────────────────

model AssessmentIndicator {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  number      Int
  indicator   String   @db.Text
  maxScore    Int      @default(4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category        AssessmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  selfAssessments SelfAssessment[]
  rubricItems     RubricItem[]
  changes         IndicatorChange[]

  @@unique([categoryId, number])
  @@map("assessment_indicators")
}

// ─────────────────────────────────────────────────────────────
// RUBRIK PENILAIAN (panduan skor per indikator)
// ─────────────────────────────────────────────────────────────

model AssessmentRubric {
  id           Int      @id @default(autoincrement())
  assessmentId Int
  title        String   @db.VarChar(255)   // judul rubrik, misal: "RUBRIK PENILAIAN KECAMATAN BERDAYA PROGRAM"
  description  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  items      RubricItem[]

  @@map("assessment_rubrics")
}

model RubricItem {
  id          Int    @id @default(autoincrement())
  rubricId    Int
  indicatorId Int                            // relasi ke indikator assessment
  score1      String @db.Text               // deskripsi skor 1
  score2      String @db.Text               // deskripsi skor 2
  score3      String @db.Text               // deskripsi skor 3
  score4      String @db.Text               // deskripsi skor 4
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rubric    AssessmentRubric    @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  indicator AssessmentIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([rubricId, indicatorId])
  @@map("rubric_items")
}

// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// ASSESSMENT UPDATE TRACKING
// ─────────────────────────────────────────────────────────────

model AssessmentVersion {
  id               Int      @id @default(autoincrement())
  assessmentId     Int      @map("assessment_id")
  versionNumber    Int      @default(1) @map("version_number")
  title            String?  @db.VarChar(255)
  description      String?  @db.Text
  changesSummary   String?  @db.Text @map("changes_summary")
  createdAt        DateTime @default(now()) @map("created_at")
  createdById      Int      @map("created_by")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("AssessmentVersionCreator", fields: [createdById], references: [id])
  
  // Relasi ke perubahan indikator
  indicatorChanges IndicatorChange[]

  @@unique([assessmentId, versionNumber])
  @@map("assessment_versions")
}

enum IndicatorChangeType {
  ADDED     // Indikator baru ditambah
  MODIFIED  // Indikator existing diubah
  REMOVED   // Indikator dihapus
}

model IndicatorChange {
  id               Int                   @id @default(autoincrement())
  versionId        Int                   @map("version_id")
  indicatorId      Int?                  @map("indicator_id")  // Null jika indikator dihapus
  changeType       IndicatorChangeType   @map("change_type")
  oldValue         Json?                 @map("old_value")     // Snapshot nilai lama (untuk MODIFIED/REMOVED)
  newValue         Json?                 @map("new_value")     // Snapshot nilai baru (untuk ADDED/MODIFIED)
  requiresResubmit Boolean               @default(true) @map("requires_resubmit")
  createdAt        DateTime              @default(now()) @map("created_at")

  version   AssessmentVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  indicator AssessmentIndicator? @relation(fields: [indicatorId], references: [id], onDelete: SetNull)

  @@map("indicator_changes")
}

enum UserAssessmentStatusEnum {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  HAS_UPDATE      // Template ada update tapi belum perlu action
  NEEDS_REVISION  // User harus mengisi ulang indikator yang berubah
  RESUBMITTED     // User sudah lengkapi revisi
}

model UserAssessmentStatus {
  id               Int                      @id @default(autoincrement())
  userId           Int                      @map("user_id")
  assessmentId     Int                      @map("assessment_id")
  currentVersion   Int                      @default(1) @map("current_version")
  latestVersion    Int                      @default(1) @map("latest_version")
  status           UserAssessmentStatusEnum @default(NOT_STARTED)
  lastViewedAt     DateTime?                @map("last_viewed_at")
  lastActivityAt   DateTime?                @map("last_activity_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  user       User       @relation("UserAssessmentStatuses", fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([userId, assessmentId])
  @@map("user_assessment_status")
}

// ─────────────────────────────────────────────────────────────
// SELF ASSESSMENT (jawaban kecamatan)
// ─────────────────────────────────────────────────────────────

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  REJECTED
}

model SelfAssessment {
  id            Int               @id @default(autoincrement())
  indicatorId   Int
  submittedById Int
  periode       String            @db.VarChar(20)
  description   String            @db.Text
  score         Int
  supportingDoc String?           @db.VarChar(500)
  status        AssessmentStatus  @default(DRAFT)
  submittedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  indicator   AssessmentIndicator    @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  submittedBy User                   @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  validations AssessmentValidation[]

  @@unique([indicatorId, submittedById, periode])
  @@map("self_assessments")
}

// ─────────────────────────────────────────────────────────────
// ASSESSMENT DRAFT BACKUP (untuk migration)
// ─────────────────────────────────────────────────────────────

model AssessmentDraftBackup {
  id              String   @id @db.VarChar(36)   // UUID
  userId          Int      @map("user_id")
  assessmentId    Int      @map("assessment_id")  
  versionNumber   Int      @map("version_number")
  answersJson     Json     @map("answers_json")   // Backup jawaban dalam JSON
  reason          String?  @db.VarChar(100)      // Alasan backup (migration, manual, etc)
  createdAt       DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId, assessmentId])
  @@index([createdAt])
  @@map("assessment_draft_backups")
}

// ─────────────────────────────────────────────────────────────
// VALIDATION
// ─────────────────────────────────────────────────────────────

enum ValidationStatus {
  APPROVED
  REJECTED
  REVISION_NEEDED
}

model AssessmentValidation {
  id               Int              @id @default(autoincrement())
  selfAssessmentId Int
  validatorId      Int
  status           ValidationStatus
  validatedScore   Int?
  notes            String?          @db.Text
  validatedAt      DateTime         @default(now())

  selfAssessment SelfAssessment @relation(fields: [selfAssessmentId], references: [id], onDelete: Cascade)
  validator      User           @relation(fields: [validatorId], references: [id], onDelete: Restrict)

  @@map("assessment_validations")
}

model AssessmentBackup {
  id             Int      @id @default(autoincrement())
  assessmentTitle String   @db.VarChar(255)
  periode         String   @db.VarChar(20)
  tahun           Int?
  kabupaten       String?  @db.VarChar(100)
  kecamatan       String?  @db.VarChar(100)
  totalScore      Int      @default(0)
  maxPossibleTotal Int     @default(0)
  statusAkhir      String? @db.VarChar(20)
  snapshot         Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([assessmentTitle, periode, kecamatan])
  @@map("assessment_backups")
}