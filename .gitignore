.vscode

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# kiro
.kiro
AGENTS.md
/src/generated/prisma
.windsurf/
.agents/
.claude/
.claude-plugin/
skills-lock.json

# temporary scripts (one-off migration/check scripts)
tmp-*.mjs

# external reference data (not part of this codebase)
wilayah/

# prisma backup files
prisma/*.backup

# uploaded banner images (generated at runtime, not versioned)
/public/banners/*
!/public/banners/.gitkeep