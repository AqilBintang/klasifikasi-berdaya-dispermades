# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# settings vscode
.vscode

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# kiro / ai tools
.kiro
AGENTS.md
/src/generated/prisma
.windsurf/
.agents/
.claude/
.claude-plugin/
skills-lock.json

# temporary scripts (one-off migration/check scripts)
tmp-*.mjs

# security/performance audit reports (internal, not for repo)
SECURITY-PERFORMANCE-*.md

# generated data files (built from db/ SQL files at build time)
src/data/wilayah-jateng.json

# runtime export output
/exports/

# external reference data (large SQL dumps, not part of codebase)
/wilayah/

# prisma backup files
prisma/*.backup

# uploaded banner images (generated at runtime, not versioned)
/public/banners/*
!/public/banners/.gitkeep

# sample/reference excel files (contains real data)
/contoh_excel/

# development documentation (local only)
fontawesome-inventory.md

# OS files
.DS_Store
desktop.ini
# temporary auth/cookie files
cookies*.txt
login*.txt
resp.txt
verbose.txt
form.html
*_cookies.txt
 kecamatan_cookies.txt
login_cookies.txt
login_output.txt
login_response.txt
