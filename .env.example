# Klas Berdaya — Environment Variables
# Salin file ini menjadi .env dan isi nilainya

# ─── Database ───────────────────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/klas_berdaya1"

# ─── Next.js ────────────────────────────────────────────────────────────────
# URL publik aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── NextAuth ───────────────────────────────────────────────────────────────
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="GANTI_DENGAN_RANDOM_STRING_MIN_32_KARAKTER"

# URL aplikasi yang digunakan NextAuth untuk redirect
NEXTAUTH_URL="http://localhost:3000"

# ─── Akun Super Admin (dibuat saat npm run db:seed) ─────────────────────────
SUPER_ADMIN_EMAIL="superadmin@example.com"
SUPER_ADMIN_PASSWORD="ganti_password_anda"

# ─── Akun Admin (dibuat saat npm run db:seed) ───────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ganti_password_anda"
